# See scripts/check-localplt.awk for how this file is processed.
# PLT use is required for the malloc family and for matherr because
# users can define their own functions and have library internals call them.
libc.so: calloc
libc.so: free
libc.so: malloc
libc.so: realloc
libm.so: matherr
# If outline atomics are used, libgcc (built outside of glibc) may
# call __getauxval using the PLT.
libc.so: __getauxval ?
# The wg14_signals N3924 entrypoints (wg14 subdir) call libc's public
# entrypoints by name with no hidden aliases for these (glibc declares
# no libc_hidden_proto for them); the sigset helpers, sigaction and
# __libc_current_sigrtmin/max bind hidden via the internal headers.
libc.so: pthread_kill
libc.so: pthread_self
libc.so: _longjmp
libc.so: __cxa_thread_atexit_impl
# stdc_raise()'s real self-delivery (raise_with_token -> syscall with
# SYS_rt_tgsigqueueinfo) and its constructed default context (getcontext)
# also bind by name: glibc has no libc_hidden_proto for either.
libc.so: syscall ?
libc.so: getcontext ?
# Internal cross-calls between the wg14 objects themselves (the
# reference implementation has no hidden-alias machinery; zero-drift).
libc.so: thread_atexit
libc.so: signal_decider_destroy
libc.so: sighandle
libc.so: internal_current_thread_id_cached_set
